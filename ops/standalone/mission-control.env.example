PORT=3005
MISSION_CONTROL_DATA_DIR=/var/lib/mission-control
MC_ALLOWED_HOSTS=localhost,127.0.0.1,::1,virtualcarhub.cloud
MC_COOKIE_SECURE=true
MC_COOKIE_SAMESITE=strict

OPENCLAW_STATE_DIR=/root/.openclaw
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=replace-with-current-token
OPENCLAW_TOOLS_PROFILE=coding
NODE_COMPILE_CACHE=/var/tmp/openclaw-compile-cache
OPENCLAW_NO_RESPAWN=1

NEXT_PUBLIC_GATEWAY_URL=wss://virtualcarhub.cloud/gw
NEXT_PUBLIC_GATEWAY_CLIENT_ID=openclaw-control-ui

MC_DEFAULT_GATEWAY_NAME=primary
MC_COORDINATOR_AGENT=coordinator
NEXT_PUBLIC_COORDINATOR_AGENT=coordinator

GRAPHITI_ENABLED=true
GRAPHITI_API_URL=http://127.0.0.1:8001
GRAPHITI_MCP_URL=http://127.0.0.1:8002
GRAPHITI_READ_ONLY=true
GRAPHITI_TIMEOUT_MS=8000
GRAPHITI_POLL_INTERVAL_MS=5000
GRAPHITI_CONFLICT_WINDOW_MINUTES=60
# GRAPHITI_API_KEY=
# Namespace selection is per-call (vch_buyer | vch_admin | vch_wholesale).
# GRAPHITI_DEFAULT_NAMESPACE is consulted only by tool-style scripts
# (e.g. scripts/graphiti-smoke.mjs) — never by the agent / API path.
# GRAPHITI_DEFAULT_NAMESPACE=vch_buyer

AUTH_SECRET=replace-with-current-auth-secret
API_KEY=replace-with-current-api-key
